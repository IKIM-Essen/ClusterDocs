// Bounded RCC classroom settings for the public nf-core/demo test profile.
// Review and replace these caps before adapting the file to real analyses.

process {
    executor = 'slurm'
    queue = 'cpu_short'
    scratch = true
    resourceLimits = [
        cpus: 4,
        memory: 16.GB,
        time: 30.m
    ]
}

executor {
    queueSize = 4
}

apptainer {
    autoMounts = true
}
